#!/usr/bin/env bash
set -eo pipefail

# git-worktree-manager: Create a git worktree with all runtime dependencies copied over

# Exit codes (stable, for scripts and AI agents)
EXIT_OK=0
EXIT_ERROR=1
EXIT_USAGE=2
EXIT_NOT_FOUND=3
EXIT_CONFIRM=4

DRY_RUN=false
USE_SYMLINK=false
LIST_ALL=false
JSON=false
ASSUME_YES=false
BASE_BRANCH=""

# --json is honored before argument parsing, so even usage errors come back as JSON
for arg in "$@"; do
    [[ "$arg" == "--json" ]] && JSON=true
done

# Colors only when stderr is a terminal and NO_COLOR is unset
if [[ -t 2 && -z "${NO_COLOR:-}" ]]; then
    RED=$'\033[0;31m'
    GREEN=$'\033[0;32m'
    YELLOW=$'\033[1;33m'
    CYAN=$'\033[0;36m'
    BOLD=$'\033[1m'
    DIM=$'\033[2m'
    NC=$'\033[0m'
else
    RED='' GREEN='' YELLOW='' CYAN='' BOLD='' DIM='' NC=''
fi

# Messages go to stderr; stdout carries only results (worktree path, list, JSON).
# With --json, progress messages are dropped and only warnings/errors remain.
log()   { $JSON || printf '%s\n' "${GREEN}[✓]${NC} $1" >&2; }
info()  { $JSON || printf '%s\n' "${CYAN}[i]${NC} $1" >&2; }
blank() { $JSON || echo "" >&2; }
warn()  { printf '%s\n' "${YELLOW}[!]${NC} $1" >&2; }
err()   { printf '%s\n' "${RED}[✗]${NC} $1" >&2; }

# Print an error and exit with the given code; with --json also print {"error", "exit_code"} on stdout
die() {
    local code="$1" msg="$2"
    err "$msg"
    if $JSON; then
        python3 -I -c 'import json, sys; print(json.dumps({"error": sys.argv[1], "exit_code": int(sys.argv[2])}))' "$msg" "$code"
    fi
    exit "$code"
}

# --- Registry: stores worktree ID -> metadata ---
REGISTRY_DIR="$HOME/.config/git-worktree-manager"
REGISTRY_FILE="$REGISTRY_DIR/registry.json"
GITHUB_OWNER="mdaneshjoo"
GITHUB_REPO="git-work-tree-manager"
GITHUB_API="https://api.github.com/repos/${GITHUB_OWNER}/${GITHUB_REPO}"
VERSION_FILE="$REGISTRY_DIR/version"

# All registry access goes through here. Values are passed as argv (never pasted into code),
# and each call holds an exclusive lock, so parallel runs (e.g. several agents) don't lose entries.
#   registry add <repo> <branch> <path> <created_at>   -> prints the new unique ID
#   registry remove <id>
#   registry find <id|branch|path> [repo]              -> id<TAB>repo<TAB>branch<TAB>path
#   registry find-branch <repo> <branch>               -> same format
#   registry list <repo|""> <table|json>
registry() {
    mkdir -p "$REGISTRY_DIR"
    python3 -I - "$REGISTRY_FILE" "$@" <<'PY'
import fcntl, json, os, random, string, sys, tempfile

path, op, args = sys.argv[1], sys.argv[2], sys.argv[3:]

with open(path + ".lock", "w") as lock:
    fcntl.flock(lock, fcntl.LOCK_EX)
    try:
        with open(path) as f:
            data = json.load(f)
    except FileNotFoundError:
        data = []

    def save():
        fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path))
        with os.fdopen(fd, "w") as f:
            json.dump(data, f, indent=2)
        os.replace(tmp, path)

    def row(e):
        return "\t".join([e["id"], e["repo"], e["branch"], e["path"]])

    if op == "add":
        repo, branch, wt_path, created_at = args
        ids = {e["id"] for e in data}
        while True:
            new_id = "".join(random.choice(string.ascii_lowercase + string.digits) for _ in range(6))
            if new_id not in ids:
                break
        data.append({"id": new_id, "repo": repo, "branch": branch, "path": wt_path, "created_at": created_at})
        save()
        print(new_id)
    elif op == "remove":
        data = [e for e in data if e["id"] != args[0]]
        save()
    elif op == "find":
        # IDs and paths are unique across repos; a branch name only matches inside the given repo
        target, repo = args[0], (args[1] if len(args) > 1 else "")
        for e in data:
            if target in (e["id"], e["path"]):
                print(row(e)); sys.exit(0)
        for e in data:
            if e["branch"] == target and (not repo or e["repo"] == repo):
                print(row(e)); sys.exit(0)
        sys.exit(1)
    elif op == "find-branch":
        repo, branch = args
        for e in data:
            if e["repo"] == repo and e["branch"] == branch:
                print(row(e)); sys.exit(0)
        sys.exit(1)
    elif op == "list":
        repo, fmt = args
        entries = [e for e in data if not repo or e["repo"] == repo]
        if fmt == "json":
            print(json.dumps(entries, indent=2))
        elif not entries:
            print("  No worktrees registered.")
        else:
            print(f'  {"ID":<8} {"Branch":<25} {"Created":<20} Path')
            print(f'  {"──":<8} {"──────":<25} {"───────":<20} ────')
            for e in entries:
                print(f'  {e["id"]:<8} {e["branch"]:<25} {e.get("created_at", "?"):<20} {e["path"]}')
PY
}

# --- GitHub helpers ---
github_get() {
    local url="$1"
    if command -v curl &>/dev/null; then
        curl -fsSL "$url" 2>/dev/null
    elif command -v wget &>/dev/null; then
        wget -qO- "$url" 2>/dev/null
    else
        die $EXIT_ERROR "curl or wget is required."
    fi
}

get_local_version() {
    if [[ -f "$VERSION_FILE" ]]; then
        cat "$VERSION_FILE"
    else
        echo "unknown"
    fi
}

get_latest_release() {
    local response
    response=$(github_get "${GITHUB_API}/releases/latest")
    if [[ -z "$response" ]]; then
        return 1
    fi
    python3 -I -c "
import json, sys
data = json.loads(sys.stdin.read())
print(data.get('tag_name', ''))
" <<< "$response"
}

# --- Self-update ---
self_update() {
    info "Checking for updates..."

    local local_version latest_version
    local_version=$(get_local_version)
    latest_version=$(get_latest_release) || {
        err "Failed to fetch latest release from GitHub."
        exit 1
    }

    if [[ -z "$latest_version" ]]; then
        err "No releases found on GitHub. Create a release/tag first."
        exit 1
    fi

    if [[ "$latest_version" == "$local_version" ]]; then
        log "Already up to date (${local_version})."
        exit 0
    fi

    info "Current version: ${BOLD}${local_version}${NC}"
    info "Latest version:  ${BOLD}${latest_version}${NC}"

    # Download the script from the release tag
    local download_url="https://raw.githubusercontent.com/${GITHUB_OWNER}/${GITHUB_REPO}/${latest_version}/git-worktree-manager"
    local tmp_file
    tmp_file=$(mktemp)
    trap 'rm -f "$tmp_file"' RETURN

    github_get "$download_url" > "$tmp_file"

    if [[ ! -s "$tmp_file" ]]; then
        err "Failed to download version ${latest_version}."
        exit 1
    fi

    # Find where the script is installed
    local script_path
    script_path="$(command -v git-worktree-manager 2>/dev/null || echo "")"
    if [[ -z "$script_path" ]]; then
        script_path="${BASH_SOURCE[0]}"
    fi
    # Resolve symlinks
    if [[ -L "$script_path" ]]; then
        script_path="$(readlink -f "$script_path" 2>/dev/null || readlink "$script_path")"
    fi

    if [[ ! -w "$script_path" ]]; then
        err "Cannot write to $script_path. Try: sudo git-worktree-manager --update"
        exit 1
    fi

    # Replace the script and save installed version
    cp "$tmp_file" "$script_path"
    chmod +x "$script_path"
    mkdir -p "$REGISTRY_DIR"
    echo "$latest_version" > "$VERSION_FILE"

    log "Updated to ${latest_version} at $script_path"
    exit 0
}

# --- Usage ---
usage() {
    cat <<USAGE
Usage: $(basename "$0") [options] <branch> [worktree-path]
       $(basename "$0") --remove <id|branch|path> [--yes]
       $(basename "$0") --list [--all]
       $(basename "$0") --update

Create a git worktree and copy runtime dependencies so the project is immediately runnable.
Each worktree gets a unique ID for easy management.

Arguments:
  branch          Branch name for the worktree (created if it doesn't exist)
  worktree-path   Optional path for the worktree (default: ../\$(basename \$PWD)-<branch>)

Copied from anywhere in the repo (monorepo packages included), if untracked:
  - Node.js / React (node_modules, .next, .nuxt, .turbo, dist, build)
  - Python          (any virtualenv, .python-version)
  - Go              (vendor, .air.toml, tmp)
  - iOS / Xcode     (Pods, .build, .swiftpm, Carthage, .xcworkspace, .xcconfig)
  - Husky           (.husky/_ helper dir)
  - All             (.env, .env.*, .tool-versions, .nvmrc, .mise.toml, ...)

Options:
  -h, --help      Show this help message
  -n, --dry-run   Show what would be copied without doing it
  --base, -b      Base branch to create the new branch from (default: current HEAD)
  --symlink       Use symlinks instead of copies for large dirs (node_modules, vendor, Pods)
  --remove, -r    Remove a worktree by ID, branch name, or path (also deletes the branch)
  --yes, -y       Don't ask for confirmation (required for --remove without a terminal)
  --list, -l      List all registered worktrees (current repo only, or --all for all repos)
  --all           Used with --list to show worktrees from all repos
  --json          Print results as JSON on stdout (progress messages are suppressed)
  --update        Update to the latest version from GitHub
  --version, -v   Show the current version

Output:
  stdout          Results only: the worktree path, the --list table, or JSON
  stderr          Progress messages, warnings, errors (no colors when not a terminal or NO_COLOR is set)

Creating a worktree for a branch that already has one returns the existing worktree (same ID and path).

Exit codes:
  0  success              3  worktree not found (--remove)
  1  error                4  confirmation required or declined (--remove)
  2  invalid usage
USAGE
    exit 0
}

# --- Remove worktree ---
remove_worktree() {
    local target="$1"
    local current_repo entry wt_id wt_repo wt_branch wt_path branch_deleted=false

    current_repo="$(git rev-parse --show-toplevel 2>/dev/null || true)"
    entry=$(registry find "$target" "$current_repo") ||
        die $EXIT_NOT_FOUND "Worktree not found for: $target (use --list to see registered worktrees)"
    IFS=$'\t' read -r wt_id wt_repo wt_branch wt_path <<< "$entry"

    blank
    info "ID:       ${BOLD}$wt_id${NC}"
    info "Branch:   $wt_branch"
    info "Path:     $wt_path"
    info "Repo:     $wt_repo"
    blank

    if ! $ASSUME_YES; then
        [[ -t 0 ]] || die $EXIT_CONFIRM "Confirmation required: re-run with --yes to remove worktree $wt_id and delete branch '$wt_branch'"
        printf '%s' "${YELLOW}[?]${NC} Remove this worktree and delete branch '${wt_branch}'? [y/N] " >&2
        local confirm
        read -r confirm || confirm=""
        if [[ "$confirm" != [yY] && "$confirm" != [yY][eE][sS] ]]; then
            warn "Aborted."
            exit $EXIT_CONFIRM
        fi
    fi

    # Run git in the worktree's own repo, which may differ from the current directory
    if [[ -d "$wt_path" ]]; then
        git -C "$wt_repo" worktree remove "$wt_path" --force >/dev/null 2>&1 || {
            warn "git worktree remove failed, cleaning up manually..."
            rm -rf "$wt_path"
            git -C "$wt_repo" worktree prune
        }
        log "Worktree removed: $wt_path"
    else
        warn "Worktree directory already gone: $wt_path"
        git -C "$wt_repo" worktree prune 2>/dev/null || true
    fi

    if [[ -n "$wt_branch" ]] && git -C "$wt_repo" rev-parse --verify "$wt_branch" >/dev/null 2>&1; then
        if git -C "$wt_repo" branch -D "$wt_branch" >/dev/null 2>&1; then
            branch_deleted=true
            log "Branch deleted: $wt_branch"
        else
            warn "Could not delete branch: $wt_branch"
        fi
    fi

    registry remove "$wt_id"
    log "Removed from registry: $wt_id"

    if $JSON; then
        python3 -I -c 'import json, sys; a = sys.argv; print(json.dumps({"id": a[1], "repo": a[2], "branch": a[3], "path": a[4], "removed": True, "branch_deleted": a[5] == "true"}, indent=2))' \
            "$wt_id" "$wt_repo" "$wt_branch" "$wt_path" "$branch_deleted"
    else
        blank
        log "Cleanup complete."
    fi
    exit $EXIT_OK
}

# --- List worktrees ---
list_worktrees() {
    local repo=""
    if ! $LIST_ALL; then
        repo="$(git rev-parse --show-toplevel 2>/dev/null)" || die $EXIT_ERROR "Not inside a git repository (use --all to list every repo)"
    fi

    if $JSON; then
        registry list "$repo" json
    else
        blank
        if $LIST_ALL; then
            info "All registered worktrees:"
        else
            info "Worktrees for ${BOLD}$(basename "$repo")${NC}:"
        fi
        blank
        registry list "$repo" table
        blank
    fi
    exit $EXIT_OK
}

# --- Runtime files to copy ---
# Matched by name at any depth, so monorepo packages (apps/*/node_modules, apps/api/.env, ...) are covered.
# Large dependency dirs (symlinked instead of copied with --symlink)
DEP_DIRS="node_modules vendor Pods Carthage .build .swiftpm"
# Build caches, only copied when they sit next to a package.json
CACHE_DIRS=".next .nuxt .turbo dist build"
CONFIG_FILES=".python-version .air.toml .editorconfig .tool-versions .nvmrc .node-version \
.ruby-version .mise.toml .mise.local.toml docker-compose.override.yml .docker-env \
GoogleService-Info.plist firebase.json"

has_word() { [[ " $2 " == *" $1 "* ]]; }

# Prints how to handle a repo-relative path: "venv", "link" (large dir), "copy", or nothing (skip)
classify_path() {
    local rel="$1"
    local src="$SOURCE_DIR/$rel"
    local name parent
    name="$(basename "$rel")"
    parent="$(dirname "$src")"

    if [[ -d "$src" ]]; then
        if [[ -f "$src/bin/activate" ]]; then
            echo "venv"
        elif has_word "$name" "$DEP_DIRS"; then
            echo "link"
        elif has_word "$name" "$CACHE_DIRS" && [[ -f "$parent/package.json" ]]; then
            echo "link"
        elif [[ "$name" == "tmp" && -f "$parent/.air.toml" ]] || [[ "$name" == *.xcworkspace ]]; then
            echo "copy"
        elif [[ "$name" == "_" && "$(basename "$parent")" == ".husky" ]]; then
            # Husky's gitignored helper dir; core.hooksPath=.husky/_ finds no hooks without it
            echo "copy"
        fi
    else
        case "$name" in
            .env|.env.*|*.xcconfig) echo "copy" ;;
            *) has_word "$name" "$CONFIG_FILES" && echo "copy" ;;
        esac
    fi
    return 0
}

# NUL-separated untracked paths, relative to the repo root.
# Ignored dirs are listed once and not descended into (fast even with huge node_modules).
list_untracked_paths() {
    git -C "$SOURCE_DIR" ls-files -z --others --ignored --exclude-standard --directory
    git -C "$SOURCE_DIR" ls-files -z --others --exclude-standard --directory
}

# --- Copy or symlink a path ---
copy_item() {
    local src="$1"
    local dst="$2"
    local name="$3"
    local use_link="${4:-false}"

    if [[ ! -e "$src" ]]; then
        return
    fi

    if [[ -e "$dst" || -L "$dst" ]]; then
        warn "Skipped (already exists in worktree): $name"
        SKIPPED+=("exists	$name")
        return
    fi

    # A symlinked parent (e.g. a tracked "apps -> /elsewhere") would make the copy land outside the worktree
    local parent="$(dirname "$dst")"
    while [[ "$parent" != "$WORKTREE_PATH" && "$parent" == "$WORKTREE_PATH"/* ]]; do
        if [[ -L "$parent" ]]; then
            warn "Skipped (parent is a symlink in worktree): $name"
            SKIPPED+=("symlinked_parent	$name")
            return
        fi
        parent="$(dirname "$parent")"
    done

    if [[ "$use_link" == "true" ]]; then
        COPIED+=("symlink	$name")
    else
        COPIED+=("copy	$name")
    fi

    if $DRY_RUN; then
        if [[ "$use_link" == "true" ]]; then
            info "[dry-run] Would symlink: $name"
        else
            info "[dry-run] Would copy: $name"
        fi
        return
    fi

    mkdir -p "$(dirname "$dst")"

    if [[ "$use_link" == "true" ]]; then
        ln -sfn "$src" "$dst"
        log "Symlinked: $name"
    else
        if [[ -d "$src" ]]; then
            cp -a "$src" "$dst"
            log "Copied dir: $name"
        else
            cp -a "$src" "$dst"
            log "Copied file: $name"
        fi
    fi
}

# --- Python: point a copied virtualenv at its new location ---
fix_venv_paths() {
    local rel="$1"
    local venv="$WORKTREE_PATH/$rel"
    local f

    for f in "$venv/pyvenv.cfg" "$venv/bin/activate"*; do
        [[ -f "$f" ]] || continue
        sed -i.gwm-bak "s|$SOURCE_DIR/$rel|$WORKTREE_PATH/$rel|g" "$f" 2>/dev/null || true
        rm -f "$f.gwm-bak"
    done
    log "Fixed virtualenv paths: $rel"
}

# --- Copy all runtime dependencies found anywhere in the repo ---
copy_runtime_files() {
    info "Copying runtime dependencies..."
    local rel kind link found=0

    while IFS= read -r -d '' rel; do
        rel="${rel%/}"
        kind="$(classify_path "$rel")"
        [[ -n "$kind" ]] || continue
        found=$((found + 1))

        link=false
        [[ "$kind" != "copy" ]] && link=$USE_SYMLINK
        copy_item "$SOURCE_DIR/$rel" "$WORKTREE_PATH/$rel" "$rel" "$link"

        if [[ "$kind" == "venv" ]] && ! $DRY_RUN && ! $link; then
            fix_venv_paths "$rel"
        fi
    done < <(list_untracked_paths | sort -zu)

    if [[ $found -eq 0 ]]; then
        warn "No runtime dependencies found to copy."
    fi
}

# --- Husky: make git hooks work in the worktree without touching the main repo ---
fix_husky_hooks() {
    [[ -d "$SOURCE_DIR/.husky" ]] || return 0
    $DRY_RUN && return 0

    local hooks_path
    hooks_path="$(git -C "$SOURCE_DIR" config core.hooksPath 2>/dev/null || true)"

    if [[ -z "$hooks_path" || "$hooks_path" != /* ]]; then
        # Unset (hooks live in the shared .git/hooks) or relative (Husky v9 uses .husky/_):
        # both already resolve correctly inside the worktree
        return 0
    fi

    if [[ "$hooks_path" == "$SOURCE_DIR"/* ]]; then
        # Absolute path into the main repo: override it for this worktree only.
        # core.hooksPath in the shared config would change the main repo's hooks too.
        local wt_hooks="$WORKTREE_PATH/${hooks_path#"$SOURCE_DIR"/}"
        if git -C "$WORKTREE_PATH" config extensions.worktreeConfig true &&
           git -C "$WORKTREE_PATH" config --worktree core.hooksPath "$wt_hooks"; then
            log "Husky hooks path set for this worktree: $wt_hooks"
        else
            warn "Could not set a per-worktree Husky hooks path (needs git 2.20+, non-critical)"
        fi
    elif [[ ! -d "$hooks_path" ]]; then
        # Left behind by older versions of this tool, which wrote a worktree path into the shared config
        warn "core.hooksPath points to a missing dir: $hooks_path"
        warn "Fix with: git -C \"$SOURCE_DIR\" config --unset core.hooksPath && npx husky"
    fi
}

# --- Result output ---
print_result() {
    local created="$1"

    if $JSON; then
        python3 -I - "$WT_ID" "$SOURCE_DIR" "$BRANCH" "$WORKTREE_PATH" "$created" "$DRY_RUN" \
            "${#COPIED[@]}" ${COPIED[@]+"${COPIED[@]}"} ${SKIPPED[@]+"${SKIPPED[@]}"} <<'PY'
import json, sys
a = sys.argv[1:]
n = int(a[6])
items = lambda rows, key: [dict(zip((key, "path"), r.split("\t", 1))) for r in rows]
print(json.dumps({
    "id": a[0] or None, "repo": a[1], "branch": a[2], "path": a[3],
    "created": a[4] == "true", "dry_run": a[5] == "true",
    "copied": items(a[7:7 + n], "mode"),
    "skipped": items(a[7 + n:], "reason"),
}, indent=2))
PY
        return
    fi

    blank
    if $DRY_RUN; then
        warn "Dry run complete. No changes were made."
    else
        log "Done! Your worktree is ready at:"
        info "   ${CYAN}cd $WORKTREE_PATH${NC}"
        info "   To remove later: ${DIM}git-worktree-manager -r $WT_ID${NC}"
    fi
    # The path is the only thing on stdout, so `cd "$(git-worktree-manager <branch>)"` works
    printf '%s\n' "$WORKTREE_PATH"
}

# --- Create worktree ---
create_worktree() {
    [[ ${#POSITIONAL[@]} -ge 1 ]] || die $EXIT_USAGE "Missing required argument: branch (see --help)"
    [[ ${#POSITIONAL[@]} -le 2 ]] || die $EXIT_USAGE "Too many arguments: ${POSITIONAL[*]} (see --help)"

    BRANCH="${POSITIONAL[0]}"
    local explicit_path="${POSITIONAL[1]:-}"
    SOURCE_DIR="$(git rev-parse --show-toplevel 2>/dev/null)" ||
        die $EXIT_ERROR "Not inside a git repository. cd into your project first."

    # Replace / in branch names with - for the directory name
    local branch_safe="${BRANCH//\//-}"
    WORKTREE_PATH="${explicit_path:-$(dirname "$SOURCE_DIR")/$(basename "$SOURCE_DIR")-${branch_safe}}"
    # Store absolute paths, so --remove and --list work from any directory
    WORKTREE_PATH="$(python3 -I -c 'import os, sys; print(os.path.abspath(sys.argv[1]))' "$WORKTREE_PATH")"
    [[ -z "$explicit_path" ]] || explicit_path="$WORKTREE_PATH"

    WT_ID=""
    COPIED=()
    SKIPPED=()

    # Idempotent: a branch that already has a registered worktree is returned as is
    local existing e_id e_repo e_branch e_path
    if existing=$(registry find-branch "$SOURCE_DIR" "$BRANCH"); then
        IFS=$'\t' read -r e_id e_repo e_branch e_path <<< "$existing"
        if [[ -d "$e_path" ]] && git -C "$e_path" rev-parse --git-dir >/dev/null 2>&1; then
            if [[ -n "$explicit_path" && "$explicit_path" != "$e_path" ]]; then
                die $EXIT_ERROR "Branch '$BRANCH' already has a worktree at $e_path"
            fi
            WT_ID="$e_id"
            WORKTREE_PATH="$e_path"
            info "Worktree for '$BRANCH' already exists (ID ${BOLD}$WT_ID${NC}), reusing it"
            print_result false
            exit $EXIT_OK
        fi
        warn "Dropping stale registry entry $e_id (directory is gone): $e_path"
        if ! $DRY_RUN; then
            registry remove "$e_id"
            git -C "$SOURCE_DIR" worktree prune 2>/dev/null || true
        fi
    fi

    blank
    info "Source:   $SOURCE_DIR"
    info "Branch:   $BRANCH"
    info "Worktree: $WORKTREE_PATH"
    blank

    if $DRY_RUN; then
        info "[dry-run] Would create worktree at $WORKTREE_PATH for branch $BRANCH"
    else
        # git's own output goes to stderr, keeping stdout for results
        if git rev-parse --verify "$BRANCH" >/dev/null 2>&1; then
            if [[ -n "$BASE_BRANCH" ]]; then
                warn "Branch '$BRANCH' already exists, ignoring --base option."
            fi
            git worktree add "$WORKTREE_PATH" "$BRANCH" >&2 ||
                die $EXIT_ERROR "git worktree add failed for branch '$BRANCH'"
        else
            if [[ -n "$BASE_BRANCH" ]]; then
                git rev-parse --verify "$BASE_BRANCH" >/dev/null 2>&1 ||
                    die $EXIT_ERROR "Base branch '$BASE_BRANCH' does not exist."
                info "Branch '$BRANCH' does not exist, creating from '$BASE_BRANCH'..."
                git worktree add -b "$BRANCH" "$WORKTREE_PATH" "$BASE_BRANCH" >&2 ||
                    die $EXIT_ERROR "git worktree add failed for branch '$BRANCH'"
            else
                info "Branch '$BRANCH' does not exist, creating from current HEAD..."
                git worktree add -b "$BRANCH" "$WORKTREE_PATH" >&2 ||
                    die $EXIT_ERROR "git worktree add failed for branch '$BRANCH'"
            fi
        fi
        log "Worktree created at $WORKTREE_PATH"

        WT_ID=$(registry add "$SOURCE_DIR" "$BRANCH" "$WORKTREE_PATH" "$(date '+%Y-%m-%d %H:%M')")
        log "Registered with ID: ${BOLD}$WT_ID${NC}"
    fi

    blank

    copy_runtime_files
    fix_husky_hooks

    print_result true
}

# --- Parse args ---
ACTION="create"
REMOVE_TARGET=""
POSITIONAL=()

while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help)        usage ;;
        -n|--dry-run)     DRY_RUN=true ;;
        --symlink)        USE_SYMLINK=true ;;
        --all)            LIST_ALL=true ;;
        --json)           JSON=true ;;
        -y|--yes)         ASSUME_YES=true ;;
        --update)         ACTION="update" ;;
        --version|-v)     ACTION="version" ;;
        --list|-l)        ACTION="list" ;;
        --base|-b)
            [[ $# -ge 2 ]] || die $EXIT_USAGE "Missing argument for --base"
            BASE_BRANCH="$2"; shift ;;
        --remove|-r)
            [[ $# -ge 2 ]] || die $EXIT_USAGE "Missing argument for --remove"
            ACTION="remove"; REMOVE_TARGET="$2"; shift ;;
        --)               shift; POSITIONAL+=("$@"); break ;;
        -*)               die $EXIT_USAGE "Unknown option: $1 (see --help)" ;;
        *)                POSITIONAL+=("$1") ;;
    esac
    shift
done

# --all alone means --list --all
if $LIST_ALL && [[ "$ACTION" == "create" && ${#POSITIONAL[@]} -eq 0 ]]; then
    ACTION="list"
fi

case "$ACTION" in
    update)  self_update ;;
    version)
        if $JSON; then
            python3 -I -c 'import json, sys; print(json.dumps({"version": sys.argv[1]}))' "$(get_local_version)"
        else
            echo "git-worktree-manager $(get_local_version)"
        fi ;;
    list)    list_worktrees ;;
    remove)  remove_worktree "$REMOVE_TARGET" ;;
    create)  create_worktree ;;
esac
